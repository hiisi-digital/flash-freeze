{
  "name": "@hiisi/flash-freeze",
  "version": "0.1.2",
  "description": "Deep immutability with compile-time and runtime guarantees.",
  "exports": "./mod.ts",
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/**/*_test.ts"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "check": "deno check mod.ts",
    "test": "deno test src/",
    "lint": "deno run -A --min-dep-age=0 jsr:@hiisi/viola-cli@^0.3.1 --project . --include ."
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "license": "MPL-2.0",
  "repository": "https://github.com/hiisi-digital/flash-freeze",
  "distDir": "target",
  "dist": {
    "node": {
      "runtime": "node",
      "versions": [
        "20",
        "22",
        "24"
      ],
      "plugins": [
        "deno-to-node"
      ]
    },
    "bun": {
      "runtime": "bun",
      "versions": [
        "latest"
      ],
      "plugins": [
        "deno-to-bun"
      ]
    }
  },
  "minimumDependencyAge": 0
}
