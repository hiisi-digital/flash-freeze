{
  "name": "@hiisi/flash-freeze",
  "version": "0.1.1",
  "description": "Deep immutability with compile-time and runtime guarantees.",
  "exports": "./mod.ts",
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/**/*_test.ts"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "check": "deno check mod.ts",
    "test": "deno test src/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0"
  }
}
